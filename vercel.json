{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/track",
      "destination": "/track.html"
    },
    {
      "source": "/user",
      "destination": "/track.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    }
  ]
}

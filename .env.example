# ==============================================================================
# Virtual Fence Map Builder - Environment Configuration Template
# ==============================================================================

# MongoDB Connection Configuration
# Paste your MongoDB Atlas or local connection URI:
#   - Local MongoDB: mongodb://localhost:27017
#   - MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017

# 1. Database for persistent geofences & real-time telemetry
MONGODB_SIMULATION_DB=simulation_data_db

# 2. Database for real multi-device GPS tracking, users, locations & events
MONGODB_TRACKING_DB=tracking_data_db

# Security & Authentication Secret Key
SECRET_KEY=virtualfence_secret_key_change_in_production_2026

# Application Server Port
PORT=5000
